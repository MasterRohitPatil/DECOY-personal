# SENTINEL GRID Environment Configuration
# Copy this file to backend/.env and fill in your values

# Cloud Supabase Database (Use IPv4 Session Pooler)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-eu-west-3.pooler.supabase.com:5432/postgres

# Google Gemini API Key (Optional with guaranteed deterministic fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Application Settings
PROJECT_NAME="SENTINEL GRID"
VERSION="1.0.0"
HOST=0.0.0.0
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
